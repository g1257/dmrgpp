##Ainur1.0
TotalNumberOfSites=4;
NumberOfTerms=2;

gt0:DegreesOfFreedom=1;
gt0:GeometryKind="chain";
gt0:GeometryOptions="ConstantValues";
gt0:dir0:Connectors=[1];

gt1:DegreesOfFreedom=1;
