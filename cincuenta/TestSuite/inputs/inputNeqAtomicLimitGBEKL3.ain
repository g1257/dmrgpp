##Ainur1.0

# True atomic-limit hopping quench for GBEK Fig. 3, L=3 second bath.
#
# Unlike inputNeqGBEKFig3L3.ain (which approximates the atomic limit with a
# near-zero-bandwidth equilibrium bath, W_i=0.1), this input sets
# NeqAtomicLimit=1 so the neq stage bypasses the equilibrium bath fit
# entirely and starts from Delta^- === 0 exactly (see
# ImpuritySolverNeqExactDiag::solveAtomicLimit() and
# cincuenta/TestSuite/gbek_reference/atomic_limit_reference.py).
#
# NeqAtomicLimit=1 means there is no equilibrium DMFT stage at all --
# cincuenta.cpp never even constructs the equilibrium bath-fit machinery.
# Equilibrium-bath-fit-only keys (NumberOfBathPoints=, ImpuritySolver=,
# FitOptions=, MinParams*=, LatticeGf=, DmftNumberOfIterations=,
# DmftTolerance=, and the whole DMRG omega-scan block) are therefore simply
# omitted below rather than set to placeholder values -- most of them
# (NumberOfBathPoints=, ImpuritySolver=, FitOptions=) are now rejected with
# an error if present at all, since they would otherwise silently do
# nothing. TargetElectronsUp=1/Down=0 is still required by the neq solver
# itself (nup_+ndown_==1 for the atomic-limit bypass).
#
# GBEK Fig. 3 parameters: U=2, 100 steps, dt=0.04 (tmax=4),
# quench to Bethe bandwidth W_f=4 (v=1), L=3 second bath rank.

FicticiousBeta=16;
ChemicalPotential=0.;
Matsubaras=200;

TargetElectronsUp=1;
TargetElectronsDown=0;

int ImpuritySite=0;
real HubbardU=2.;

# Non-equilibrium: hopping quench, atomic limit start.  U=2 fixed.
HubbardUFinal=2.;
TmaxNeq=4.0;
NtNeq=100;

NeqDmftIter=3;
NeqDmftTolerance=1e-8;

# ED solver with GBEK second bath, rank L=3 (NeqSolver="ed" is the default;
# written here for clarity)
NeqSolver="ed";
NeqBathRank=3;
NeqAtomicLimit=1;

# BandwidthFinal=4 -> v_f = 1 -> vHopFinal_ = 1.
BandwidthFinal=4.;
QuenchShape="cosine";
QuenchDuration=0.25;

NeqOutputPrefix="atomic-limit-gbek-L3";
