##Ainur1.0

# Nightly fitted-first-bath stress fixture with an L=3 second bath.
#
# This deliberately expensive near-atomic calculation exercises the general
# equilibrium-to-real-time handoff. It is not a GBEK paper-figure source and
# is not used by plot or report regeneration; those calculations start from
# the true atomic limit via inputNeqAtomicLimitGBEKL3.ain.
#
# GBEK Fig. 3-like parameters: U=2, 100 steps, dt=0.04 (tmax=4),
# atomic limit start (W_i~0), quench to Bethe bandwidth W_f=4 (t*=1).
#
# Approximation: W_i=0.1 (nearly atomic; Λ^- << Λ^+), cosine ramp tq=0.25.
#
# L=3: second bath rank 3 (Lbath=2L=6, matching GBEK Fig. 3 setup).
# Correlations expected to persist to t≈2.5 (vs t≈1.5 for L=2).

FicticiousBeta=16;
ChemicalPotential=1.;  # HubbardU/2, required by FitOptions=particleholesymmetric
Matsubaras=200;
LatticeGf="energy,semicircular,0.1";
NumberOfBathPoints=5;

DmftNumberOfIterations=10;
DmftTolerance=0.001;
ImpuritySolver="exactdiag";

FitOptions=particleholesymmetric;
MinParamsDelta=0.01;
MinParamsMaxIter=10000;
MinParamsDelta2=0.01;
MinParamsTolerance=1e-3;
MinParamsVerbose=1;

TargetElectronsUp=3;
TargetElectronsDown=3;

int ImpuritySite=0;
real HubbardU=2.;

# DMRG settings (required by ParamsDmftSolver; unused for exactdiag)
RootOutputname="NeqGBEKFig3L3";
InfiniteLoopKeptStates=200;
matrix FiniteLoopsGs=[[@auto, 200, 0],[@auto, 200, 0]];

real OmegaBegin=-6.;
integer OmegaTotal=120;
real OmegaStep=0.1;
real OmegaDelta=0.1;

integer TridiagSteps=400;
real TridiagEps=1e-9;
TruncationTolerance="1e-10,100";
CorrectionVectorEta=0.;
GsWeight=0.1;

matrix FiniteLoopsOmega=[[@auto, 200, 2],[@auto, 200, 2]];

# Non-equilibrium: hopping quench W_i=0.1 -> W_f=4.  U=2 fixed.
HubbardUFinal=2.;
TmaxNeq=4.0;
NtNeq=100;

NeqDmftIter=3;

# GBEK second bath, rank L=3.
NeqBathRank=3;

# BandwidthFinal=4 -> t*_f = 1 -> tStarFinalSq_ = 1.
BandwidthFinal=4.;
QuenchShape="cosine";
QuenchDuration=0.25;

NeqOutputPrefix="gebk-fig3-L3";
