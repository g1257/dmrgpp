TargetElectronsUp=1;
TargetElectronsDown=0;

int ImpuritySite=0;
real HubbardU=2.;
HubbardUFinal=2.;
TmaxNeq=0.1;
NtNeq=1;
NeqDmftIter=1;
NeqBathRank=1;
NeqAtomicLimit=1;

NeqSolver="exactdiag";
